schema ProviderConfig [version(1)];

message HttpConfig {
  @Min(1) @Max(65535) uint32 port;
  bool tls;
  @Size(min = 1, max = 16) @Pattern("^[a-z]+$") string mode;
  optional string label default "default";
}

message BatchConfig {
  @Min(1) @Max(1024) uint32 batch;
  @Min(1) @Max(64) uint32 concurrency;
}

message HeaderItem {
  @Size(min = 1, max = 32) @Pattern("^[a-z-]+$")
  string name;
  @Size(max = 64)
  string value;
}

message HeaderListConfig {
  @Size(max = 4)
  list<HeaderItem> headers;
}

