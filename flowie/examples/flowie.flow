source mqtt_packet_in adapter mqtt.endpoint
stage mqtt_accept adapter queue.mqtt.accept
source mqtt_accepted adapter queue.mqtt.accepted
stage rules_route operation rules.apply resource mqtt.routing
stage mqtt_fanout adapter mqtt.endpoint
stage application_output adapter socket.application.output

stage main {
  mqtt_packet_in -> mqtt_accept
  mqtt_accepted -> rules_route -> [mqtt_fanout, application_output]
}
