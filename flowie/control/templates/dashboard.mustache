<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"historyEnabled":false,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}]}'>
  <title>{{page_title}}</title>
  <link rel="stylesheet" href="/v1/management/assets/control.css">
  <script src="/v1/management/assets/htmx-2.0.9.min.js" defer></script>
  <script src="/v1/management/assets/control.js" defer></script>
</head>
<body>
  <header class="topbar">
    <div class="topbar__inner">
      <div>
        <p class="eyebrow">Access control</p>
        <h1>Flowie Control</h1>
      </div>
      <div class="topbar__actions">
        <span class="environment">Management plane</span>
        <form method="post" action="/v1/management/logout">
          <button class="button--topbar" type="submit">Sign out</button>
        </form>
      </div>
    </div>
  </header>
  <main id="dashboard"
        class="dashboard"
        hx-get="{{content_url}}"
        hx-trigger="load"
        hx-target="this"
        hx-swap="innerHTML">
    <div class="loading" role="status">Loading control state</div>
  </main>
</body>
</html>
