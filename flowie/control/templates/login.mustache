<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in | Flowie Control</title>
  <link rel="stylesheet" href="/v2/control/assets/control.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-panel" aria-labelledby="login-title">
      <header class="auth-brand">
        <p class="eyebrow">Management plane</p>
        <h1 id="login-title">Flowie Control</h1>
      </header>

      <nav class="scope-switch" aria-label="Sign-in scope">
        <a href="/v2/control/login" {{#system_mode}}aria-current="page"{{/system_mode}}>System administrator</a>
        <a href="/v2/control/login?scope=group" {{#group_mode}}aria-current="page"{{/group_mode}}>Domain</a>
      </nav>

      {{#error}}<p class="auth-error" role="alert">The username or password is incorrect.</p>{{/error}}

      <form class="auth-form" method="post" action="/v2/control/login">
        {{#system_mode}}
        <input type="hidden" name="domain" value="system">
        <div class="scope-field"><span>Scope</span><strong>System</strong></div>
        {{/system_mode}}
        {{#group_mode}}
        <label>Domain
          <input name="domain" required maxlength="128" autocomplete="organization" placeholder="root-a">
        </label>
        {{/group_mode}}
        <label>Username
          <input name="principal" required maxlength="128" autocomplete="username">
        </label>
        <label>Password
          <input name="password" type="password" required maxlength="4096" autocomplete="current-password">
        </label>
        <button type="submit">Sign in</button>
      </form>
    </section>
  </main>
</body>
</html>
