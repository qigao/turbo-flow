<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Change password | Flowie Control</title>
  <link rel="stylesheet" href="/v2/control/assets/control.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-panel" aria-labelledby="password-title">
      <header class="auth-brand">
        <p class="eyebrow">Account security</p>
        <h1 id="password-title">Change password</h1>
      </header>
      <form class="auth-form" method="post" action="/v2/control/password">
        <input type="hidden" name="csrf" value="{{csrf}}">
        <label>New password
          <input name="new_password" type="password" required minlength="16" maxlength="4096" autocomplete="new-password">
        </label>
        <label>Confirm password
          <input name="confirm_password" type="password" required minlength="16" maxlength="4096" autocomplete="new-password">
        </label>
        <button type="submit">Change password</button>
      </form>
    </section>
  </main>
</body>
</html>
