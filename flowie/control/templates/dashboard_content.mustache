<div class="dashboard__inner">
  <nav class="dashboard-nav" aria-label="Control sections">
    <div class="dashboard-nav__group">
      <p class="dashboard-nav__label">Workspace</p>
      <a href="{{overview_path}}"{{#is_overview}} aria-current="page"{{/is_overview}}>Overview</a>
    </div>
    <div class="dashboard-nav__group">
      <p class="dashboard-nav__label">Records</p>
      <a href="{{users_path}}"{{#is_users}} aria-current="page"{{/is_users}}>Users</a>
      <a href="{{groups_path}}"{{#is_groups}} aria-current="page"{{/is_groups}}>Groups</a>
      <a href="{{roles_path}}"{{#is_roles}} aria-current="page"{{/is_roles}}>Roles</a>
      <a href="{{acls_path}}"{{#is_acls}} aria-current="page"{{/is_acls}}>ACL rules</a>
      {{#can_audit_read}}<a href="{{audit_path}}"{{#is_audit}} aria-current="page"{{/is_audit}}>Audit</a>{{/can_audit_read}}
    </div>
  </nav>

  <div class="dashboard__content">
  {{#can_select_root}}<form class="root-scope" hx-get="/v2/control/dashboard/content" hx-trigger="change from:#domain-scope" hx-target="#dashboard" hx-swap="innerHTML">
    <label for="domain-scope">Domain</label>
    <input id="domain-scope" name="domain_id" list="domains" value="{{domain_id}}" required maxlength="255" aria-label="Domain">
    <datalist id="domains">{{#domains}}<option value="{{domain_id}}"></option>{{/domains}}</datalist>
  </form>{{/can_select_root}}
  <div id="dashboard-feedback" class="feedback" aria-live="polite"></div>
  {{#credential_issued}}<section class="credential-secret" data-credential-secret tabindex="-1" aria-labelledby="credential-secret-title" aria-describedby="credential-secret-guidance">
    <div class="credential-secret__heading"><div><p class="eyebrow">Service credential</p><h2 id="credential-secret-title">New token ready</h2></div><button type="button" class="button--quiet" data-dismiss-credential>Dismiss token</button></div>
    <dl class="credential-secret__identity"><div><dt>Domain</dt><dd>{{credential_domain}}</dd></div><div><dt>Service ID</dt><dd>{{credential_principal}}</dd></div></dl>
    <p id="credential-secret-guidance">Copy this token now. It will not be shown again. Issuing another token immediately invalidates this one.</p>
    <div class="credential-secret__value"><code data-credential-token tabindex="0">{{credential_token}}</code><button type="button" data-copy-credential>Copy token</button></div>
    <output class="credential-secret__status" data-credential-copy-status aria-live="polite"></output>
  </section>{{/credential_issued}}
  <template id="user-picker-options">{{#user_options}}<button type="button" class="entity-picker__option" data-picker-option data-value="{{principal_id}}" role="option" aria-selected="false" tabindex="-1"{{^enabled}} disabled{{/enabled}}><span>{{principal_id}}</span><small>{{principal_type}}</small></button>{{/user_options}}{{^user_options}}<p class="empty">No users yet. Create a user to assign access.</p>{{/user_options}}</template>
  <template id="group-picker-options">{{#group_options}}<button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{group_id}}" role="option" aria-selected="false" tabindex="-1"{{^enabled}} disabled{{/enabled}}><span>{{tree_label}}</span><small>Group</small></button>{{/group_options}}{{^group_options}}<p class="empty">No groups yet. Create a group to organize access.</p>{{/group_options}}</template>
  <template id="group-member-picker-options">{{#group_options}}<button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{group_id}}" role="option" aria-selected="false" tabindex="-1"{{#add_disabled}} disabled{{/add_disabled}}><span>{{tree_label}}</span><small>Group</small></button>{{/group_options}}{{^group_options}}<p class="empty">No groups available for membership.</p>{{/group_options}}</template>
  <template id="group-parent-picker-options"><button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{domain_id}}" role="option" aria-selected="false" tabindex="-1"><span>{{domain_id}}</span><small>Domain</small></button>{{#group_options}}<button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{group_id}}" role="option" aria-selected="false" tabindex="-1"{{#parent_disabled}} disabled{{/parent_disabled}}><span>{{tree_label}}</span><small>Group</small></button>{{/group_options}}{{^group_options}}<p class="empty">No groups yet. Create a group to organize access.</p>{{/group_options}}</template>
  <template id="role-picker-options">{{#role_options}}<button type="button" class="entity-picker__option" data-picker-option data-value="{{role_id}}" role="option" aria-selected="false" tabindex="-1"{{^enabled}} disabled{{/enabled}}><span>{{role_id}}</span><small>Role</small></button>{{/role_options}}{{^role_options}}<p class="empty">No roles yet. Create a role to assign permissions.</p>{{/role_options}}</template>
  <template id="acl-builder-template">
    <div class="acl-builder" data-acl-builder>
      <div class="acl-builder__grid">
        <label>User<select data-acl-subject required><option value="">Select user</option>{{#user_options}}<option value="{{principal_id}}"{{^enabled}} disabled{{/enabled}}>{{principal_id}}</option>{{/user_options}}</select></label>
        <label>Connection<select data-acl-connection><option value="allow">Allow connection</option><option value="deny">Deny connection</option></select></label>
        <label class="acl-builder__entries">Topic permissions<textarea data-acl-entries rows="8" maxlength="16000" spellcheck="false" placeholder="write topic {{domain_id}}/groups/operators/devices/%u/{event,heartbeat}"></textarea><small>One statement per line. Read permits subscriptions; write permits publishing. Use %u for MQTT username and %c for client ID.</small></label>
      </div>
      <div class="acl-preview"><span>Canonical document</span><output data-acl-preview></output></div>
      <input type="hidden" name="rule_line" data-acl-rule required>
    </div>
  </template>

  {{#show_overview}}<section id="overview" class="summary" aria-labelledby="summary-title">
    <div class="section-heading">
      <div><p class="eyebrow">Current state</p><h2 id="summary-title">Policy overview</h2></div>
      <div class="dataset-toolbar">
        <span class="scope">Domain: {{domain_id}} · User: {{actor}}</span>
        {{#can_create_domain}}<button type="button" popovertarget="domain-add">Add domain</button>{{/can_create_domain}}
      </div>
    </div>
    {{#can_create_domain}}<div id="domain-add" class="control-popover" popover>
      <div class="popover-heading"><div><p class="eyebrow">Domains</p><h3>Create a domain</h3></div><button type="button" class="button--close" popovertarget="domain-add" popovertargetaction="hide" aria-label="Close" title="Close"></button></div>
      <p class="task-hint">Create the isolation boundary first, then switch to it to add service or human users.</p>
      <div class="command command--compact">
        <input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="domain.create">
        <label>Domain ID<input name="domain_id" required maxlength="255" autocomplete="off"></label>
        <input type="hidden" name="request_id" data-request-id>
        <button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Create domain</button>
      </div>
    </div>{{/can_create_domain}}
    <dl class="metrics">
      <div><dt>Policy version</dt><dd>{{policy_version}}</dd></div>
      <div><dt>Draft rules</dt><dd>{{draft_rule_count}}</dd></div>
      <div><dt>Published rules</dt><dd>{{published_rule_count}}</dd></div>
    </dl>
  </section>{{/show_overview}}

  {{#show_users}}<section id="users" class="dataset" aria-labelledby="users-title">
    <div class="section-heading">
      <div><p class="eyebrow">Directory</p><h2 id="users-title">Users</h2></div>
      <div class="dataset-toolbar" role="group" aria-label="Users tools">
        <button type="button" class="button--quiet" popovertarget="users-query">Query</button>
        {{#can_user_admin}}<button type="button" popovertarget="users-add">Add</button>{{/can_user_admin}}
      </div>
    </div>
    <div id="users-query" class="control-popover" popover>
      <div class="popover-heading"><div><p class="eyebrow">Users</p><h3>Query from cursor</h3></div><button type="button" class="button--close" popovertarget="users-query" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div>
      <div class="query-panel">
        <label>Start after user ID<input name="users_after" required maxlength="255"></label>
        <button type="button" hx-get="{{users_pager.query_url}}" hx-include="closest .query-panel" hx-select="#users" hx-target="#users" hx-swap="outerHTML" hx-disabled-elt="this">Query users</button>
      </div>
    </div>
    {{#can_user_admin}}
    <div id="users-add" class="control-popover" popover>
      <div class="popover-heading"><div><p class="eyebrow">Users</p><h3>Add user</h3></div><button type="button" class="button--close" popovertarget="users-add" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div>
      <div class="command command--compact">
        <input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="user.create">
        <label>User ID<input name="principal_id" required maxlength="255"></label>
        <label>Type<input name="principal_type" list="principal-types" required maxlength="63" placeholder="service"></label>
        <datalist id="principal-types"><option value="service"></option><option value="device"></option><option value="human"></option></datalist>
        <input type="hidden" name="request_id" data-request-id>
        <button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Add user</button>
      </div>
    </div>
    {{/can_user_admin}}
    <div class="table-wrap"><table><thead><tr><th>ID</th><th>Type</th><th>Status</th><th class="actions-column">Actions</th></tr></thead><tbody>
      {{#users}}<tr><td>{{principal_id}}</td><td>{{principal_type}}</td><td>{{#enabled}}Enabled{{/enabled}}{{^enabled}}Disabled{{/enabled}}</td><td class="table-actions">
        {{#can_security_admin}}{{#is_service}}{{#enabled}}<button type="button" class="button--quiet" popovertarget="service-token-{{row_index}}">Issue token</button><button type="button" class="button--quiet button--danger-text" popovertarget="service-token-revoke-{{row_index}}">Revoke token</button>{{/enabled}}{{/is_service}}{{/can_security_admin}}
        {{#can_manage_access}}<button type="button" class="button--quiet" popovertarget="user-access-{{row_index}}">Manage access</button>{{/can_manage_access}}
        {{#can_user_admin}}{{#enabled}}<button type="button" class="button--quiet button--danger-text" popovertarget="user-delete-{{row_index}}">Delete</button>{{/enabled}}{{^enabled}}<button type="button" class="button--quiet" disabled>Delete</button>{{/enabled}}{{/can_user_admin}}
        {{^can_manage_access}}{{^can_user_admin}}<span class="muted">View only</span>{{/can_user_admin}}{{/can_manage_access}}
        {{#can_manage_access}}
        <div id="user-access-{{row_index}}" class="control-popover control-popover--wide" popover>
          <div class="popover-heading"><div><p class="eyebrow">{{principal_id}}</p><h3>Manage user access</h3></div><button type="button" class="button--close" popovertarget="user-access-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div>
          <p class="task-hint">Choose a group or role from the directory, review the selection, then apply the required action.</p>
          <div class="command-grid">
            {{#can_user_admin}}<section class="access-task" data-entity-picker><h4>Group membership</h4><p class="muted">Membership inherits access from parent groups.</p><div class="entity-picker__pane"><h4>Group tree</h4><div class="entity-picker__list" data-picker-options="group-member-picker-options" role="listbox" aria-label="Group tree"></div></div><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No group selected</output><div class="task-actions"><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.member.add"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="group_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Add to group</button></div><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.member.remove"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="group_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" class="button--secondary" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Remove from group</button></div></div></section>{{/can_user_admin}}
            {{#can_security_admin}}<section class="access-task" data-entity-picker><h4>Role assignment</h4><p class="muted">Roles grant the permissions defined by ACL rules.</p><div class="entity-picker__pane"><h4>Available roles</h4><div class="entity-picker__list" data-picker-options="role-picker-options" role="listbox" aria-label="Available roles"></div></div><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No role selected</output>{{#role_options_truncated}}<p class="notice-inline">Only the first 100 roles are available.</p>{{/role_options_truncated}}<div class="task-actions"><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.assign"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="role_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Assign role</button></div><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.remove"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="role_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" class="button--secondary" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Remove role</button></div></div></section>{{/can_security_admin}}
          </div>
        </div>
        {{/can_manage_access}}
        {{#can_security_admin}}{{#is_service}}{{#enabled}}<div id="service-token-{{row_index}}" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">{{principal_id}}</p><h3>Issue service token</h3></div><button type="button" class="button--close" popovertarget="service-token-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close"></button></div><p class="task-hint">The new token replaces any existing token immediately and is shown only once.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="credential.issue"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="request_id" data-request-id><button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Issue a new token and invalidate any existing token?">Issue new token</button></div></div><div id="service-token-revoke-{{row_index}}" class="control-popover control-popover--danger" popover><div class="popover-heading"><div><p class="eyebrow">{{principal_id}}</p><h3>Revoke service token</h3></div><button type="button" class="button--close" popovertarget="service-token-revoke-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close"></button></div><p class="task-hint">The service will be unable to authenticate until a new token is issued.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="credential.revoke"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="request_id" data-request-id><button type="button" class="button--danger" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Revoke this service token now?">Revoke token</button></div></div>{{/enabled}}{{/is_service}}{{/can_security_admin}}
        {{#can_user_admin}}{{#enabled}}<div id="user-delete-{{row_index}}" class="control-popover control-popover--danger" popover><div class="popover-heading"><div><p class="eyebrow">{{principal_id}}</p><h3>Delete user</h3></div><button type="button" class="button--close" popovertarget="user-delete-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="muted">This disables sign-in while retaining audit history.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="user.disable"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="request_id" data-request-id><button type="button" class="button--danger" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Disable this user?">Disable user</button></div></div>{{/enabled}}{{/can_user_admin}}
      </td></tr>{{/users}}
      {{^users}}<tr><td colspan="4" class="empty">No users yet.{{#can_user_admin}} Use Add to create the first user.{{/can_user_admin}}</td></tr>{{/users}}
    </tbody></table></div>
    <div class="dataset-footer"><div class="pager" role="group" aria-label="Users pagination"><span class="pager__status">{{users_pager.count}} shown</span>{{#users_pager.first}}<button type="button" class="button--quiet" hx-get="{{users_pager.first_url}}" hx-select="#users" hx-target="#users" hx-swap="outerHTML">First page</button>{{/users_pager.first}}{{^users_pager.first}}<button type="button" class="button--quiet" disabled>First page</button>{{/users_pager.first}}{{#users_pager.more}}<button type="button" class="button--quiet" hx-get="{{users_pager.more_url}}" hx-select="#users" hx-target="#users" hx-swap="outerHTML">Next page</button>{{/users_pager.more}}{{^users_pager.more}}<button type="button" class="button--quiet" disabled>Next page</button>{{/users_pager.more}}</div></div>
  </section>{{/show_users}}

  {{#show_groups}}<section id="groups" class="dataset" aria-labelledby="groups-title">
    <div class="section-heading"><div><p class="eyebrow">Hierarchy</p><h2 id="groups-title">Groups</h2></div><div class="dataset-toolbar" role="group" aria-label="Groups tools">{{#can_user_admin}}<button type="button" popovertarget="groups-add">Add</button>{{/can_user_admin}}</div></div>
    {{#can_user_admin}}<div id="groups-add" class="control-popover control-popover--wide" popover><div class="popover-heading"><div><p class="eyebrow">Groups</p><h3>Create a group</h3></div><button type="button" class="button--close" popovertarget="groups-add" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Select where the group belongs in the hierarchy, then give the new group a unique ID.</p><div class="command command--compact" data-entity-picker><div class="entity-picker"><section class="entity-picker__pane"><h4>Parent group tree</h4><div class="entity-picker__list" data-picker-options="group-parent-picker-options" role="listbox" aria-label="Parent group tree"></div></section><section class="entity-picker__pane entity-picker__pane--target"><h4>Selected parent</h4><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No parent selected</output></section></div><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.create"><input type="hidden" name="parent_group_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><label>New group ID<input name="group_id" required maxlength="255" placeholder="for example: operations-east"></label><button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Create child group</button></div></div>{{/can_user_admin}}
    <div class="group-tree" role="tree" aria-label="Group hierarchy">
      {{#group_options}}<div class="group-tree__node group-tree__node--depth-{{depth}}" role="treeitem" aria-level="{{aria_level}}">
        <div class="group-tree__branch"><div class="group-tree__identity"><strong>{{group_id}}</strong><span class="group-tree__status">{{#enabled}}Enabled{{/enabled}}{{^enabled}}Disabled{{/enabled}}</span><small>{{#parent_group_id}}Parent: {{parent_group_id}}{{/parent_group_id}}{{^parent_group_id}}Domain root{{/parent_group_id}}</small></div><div class="group-tree__actions">{{#can_user_admin}}{{#member_allowed}}<button type="button" class="button--quiet" popovertarget="group-members-{{row_index}}">Members</button>{{/member_allowed}}{{^member_allowed}}<button type="button" class="button--quiet" disabled title="Memberships require an enabled group">Members</button>{{/member_allowed}}{{#delete_candidate}}<button type="button" class="button--quiet button--danger-text" popovertarget="group-delete-{{row_index}}">Delete</button>{{/delete_candidate}}{{^delete_candidate}}<button type="button" class="button--quiet" disabled title="Delete child groups first">Delete</button>{{/delete_candidate}}{{/can_user_admin}}{{^can_user_admin}}<span class="muted">View only</span>{{/can_user_admin}}</div></div>
        {{#can_user_admin}}{{#member_allowed}}<div id="group-members-{{row_index}}" class="control-popover control-popover--wide" popover><div class="popover-heading"><div><p class="eyebrow">{{group_id}}</p><h3>Add a user to this group</h3></div><button type="button" class="button--close" popovertarget="group-members-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Choose a user from the directory. The target group is fixed to <strong>{{group_id}}</strong>.</p><div class="command command--compact" data-entity-picker><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.member.add"><input type="hidden" name="group_id" value="{{group_id}}"><input type="hidden" name="principal_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><div class="entity-picker"><section class="entity-picker__pane" aria-labelledby="group-users-{{row_index}}"><h4 id="group-users-{{row_index}}">All users</h4><div class="entity-picker__list" data-picker-options="user-picker-options" role="listbox" aria-label="All users"></div></section><section class="entity-picker__pane entity-picker__pane--target"><h4>Target group</h4><p class="entity-picker__target-name">{{group_id}}</p><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No user selected</output></section></div>{{#user_options_truncated}}<p class="notice-inline">Only the first 100 users are available. Use the Users page for other assignments.</p>{{/user_options_truncated}}<button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Add selected user</button></div></div>{{/member_allowed}}
        {{#delete_candidate}}<div id="group-delete-{{row_index}}" class="control-popover control-popover--danger" popover><div class="popover-heading"><div><p class="eyebrow">{{group_id}}</p><h3>Delete group</h3></div><button type="button" class="button--close" popovertarget="group-delete-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="muted">Only an empty leaf group can be deleted. Remove memberships and ACL references first.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.delete"><input type="hidden" name="group_id" value="{{group_id}}"><input type="hidden" name="request_id" data-request-id><button type="button" class="button--danger" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Permanently delete this empty group?">Delete group</button></div></div>{{/delete_candidate}}
        {{/can_user_admin}}
      </div>{{/group_options}}
      {{^group_options}}<p class="empty">No groups yet.{{#can_user_admin}} Use Add to create the first group.{{/can_user_admin}}</p>{{/group_options}}
    </div>
  </section>{{/show_groups}}

  {{#show_roles}}<section id="roles" class="dataset" aria-labelledby="roles-title">
    <div class="section-heading"><div><p class="eyebrow">Authorization</p><h2 id="roles-title">Roles</h2></div><div class="dataset-toolbar" role="group" aria-label="Roles tools"><button type="button" class="button--quiet" popovertarget="roles-query">Query</button>{{#can_security_admin}}<button type="button" popovertarget="roles-add">Add</button>{{/can_security_admin}}</div></div>
    <div id="roles-query" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">Roles</p><h3>Query from cursor</h3></div><button type="button" class="button--close" popovertarget="roles-query" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><div class="query-panel"><label>Start after role ID<input name="roles_after" required maxlength="63"></label><button type="button" hx-get="{{roles_pager.query_url}}" hx-include="closest .query-panel" hx-select="#roles" hx-target="#roles" hx-swap="outerHTML" hx-disabled-elt="this">Query roles</button></div></div>
    {{#can_security_admin}}<div id="roles-add" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">Roles</p><h3>Create role</h3></div><button type="button" class="button--close" popovertarget="roles-add" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Create a named role, then reference it from ACL rules and assign users from the role directory.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.create"><input type="hidden" name="request_id" data-request-id><label>Role name<input name="role_id" required maxlength="63" placeholder="for example: event-publisher"></label><button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Create role</button></div></div>{{/can_security_admin}}
    <div class="table-wrap"><table><thead><tr><th>ID</th><th>Status</th><th class="actions-column">Actions</th></tr></thead><tbody>
      {{#roles}}<tr><td>{{role_id}}</td><td>{{#enabled}}Enabled{{/enabled}}{{^enabled}}Disabled{{/enabled}}</td><td class="table-actions">{{#can_security_admin}}<button type="button" class="button--quiet" popovertarget="role-assignments-{{row_index}}">Assignments</button>{{#enabled}}<button type="button" class="button--quiet button--danger-text" popovertarget="role-delete-{{row_index}}">Delete</button>{{/enabled}}{{^enabled}}<button type="button" class="button--quiet" disabled>Delete</button>{{/enabled}}{{/can_security_admin}}{{^can_security_admin}}<span class="muted">View only</span>{{/can_security_admin}}
        {{#can_security_admin}}<div id="role-assignments-{{row_index}}" class="control-popover control-popover--wide" popover><div class="popover-heading"><div><p class="eyebrow">{{role_id}}</p><h3>Manage role assignments</h3></div><button type="button" class="button--close" popovertarget="role-assignments-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Choose a user from the directory, then assign or remove this role.</p><div data-entity-picker><div class="entity-picker"><section class="entity-picker__pane" aria-labelledby="role-users-{{row_index}}"><h4 id="role-users-{{row_index}}">All users</h4><div class="entity-picker__list" data-picker-options="user-picker-options" role="listbox" aria-label="All users"></div></section><section class="entity-picker__pane entity-picker__pane--target"><h4>Target role</h4><p class="entity-picker__target-name">{{role_id}}</p><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No user selected</output></section></div>{{#user_options_truncated}}<p class="notice-inline">Only the first 100 users are available. Use the Users page for other assignments.</p>{{/user_options_truncated}}<div class="task-actions"><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.assign"><input type="hidden" name="role_id" value="{{role_id}}"><input type="hidden" name="principal_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Assign selected user</button></div><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.remove"><input type="hidden" name="role_id" value="{{role_id}}"><input type="hidden" name="principal_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" class="button--secondary" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Remove selected user</button></div></div></div></div>
        {{#enabled}}<div id="role-delete-{{row_index}}" class="control-popover control-popover--danger" popover><div class="popover-heading"><div><p class="eyebrow">{{role_id}}</p><h3>Delete role</h3></div><button type="button" class="button--close" popovertarget="role-delete-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="muted">Remove ACL references first. Deleting the role disables it and revokes any remaining user assignments.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.disable"><input type="hidden" name="role_id" value="{{role_id}}"><input type="hidden" name="request_id" data-request-id><button type="button" class="button--danger" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Disable this role and revoke remaining assignments?">Disable role</button></div></div>{{/enabled}}{{/can_security_admin}}
      </td></tr>{{/roles}}
      {{^roles}}<tr><td colspan="3" class="empty">No roles yet.{{#can_security_admin}} Use Add to create the first role.{{/can_security_admin}}</td></tr>{{/roles}}
    </tbody></table></div>
    <div class="dataset-footer"><div class="pager" role="group" aria-label="Roles pagination"><span class="pager__status">{{roles_pager.count}} shown</span>{{#roles_pager.first}}<button type="button" class="button--quiet" hx-get="{{roles_pager.first_url}}" hx-select="#roles" hx-target="#roles" hx-swap="outerHTML">First page</button>{{/roles_pager.first}}{{^roles_pager.first}}<button type="button" class="button--quiet" disabled>First page</button>{{/roles_pager.first}}{{#roles_pager.more}}<button type="button" class="button--quiet" hx-get="{{roles_pager.more_url}}" hx-select="#roles" hx-target="#roles" hx-swap="outerHTML">Next page</button>{{/roles_pager.more}}{{^roles_pager.more}}<button type="button" class="button--quiet" disabled>Next page</button>{{/roles_pager.more}}</div></div>
  </section>{{/show_roles}}

  {{#show_acls}}<section id="acl-rules" class="dataset" aria-labelledby="policy-title">
    <div class="section-heading"><div><p class="eyebrow">Draft</p><h2 id="policy-title">User ACLs</h2></div><div class="dataset-toolbar" role="group" aria-label="User ACL tools"><button type="button" class="button--quiet" popovertarget="acl-query">Query</button>{{#can_policy_admin}}<button type="button" popovertarget="acl-add">Add</button><button type="button" class="button--secondary" popovertarget="acl-publish">Publish</button>{{/can_policy_admin}}</div></div>
    <div id="acl-query" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">User ACLs</p><h3>Query from cursor</h3></div><button type="button" class="button--close" popovertarget="acl-query" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><div class="query-panel"><label>Start after ordinal<input name="policy_after" required inputmode="numeric"></label><button type="button" hx-get="{{policy_pager.query_url}}" hx-include="closest .query-panel" hx-select="#acl-rules" hx-target="#acl-rules" hx-swap="outerHTML" hx-disabled-elt="this">Query ACLs</button></div></div>
    {{#can_policy_admin}}<div id="acl-add" class="control-popover control-popover--wide" popover><div class="popover-heading"><div><p class="eyebrow">User ACLs</p><h3>Add user ACL</h3></div><button type="button" class="button--close" popovertarget="acl-add" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="policy.rule.put"><input type="hidden" name="request_id" data-request-id><label>Evaluation order<input name="ordinal" required inputmode="numeric" min="0" placeholder="for example: 10"><small>Each user can have one ACL document.</small></label><div data-acl-builder-host data-domain="{{domain_id}}"></div><button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Add to draft</button></div></div>
    <div id="acl-publish" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">ACL rules</p><h3>Publish policy</h3></div><button type="button" class="button--close" popovertarget="acl-publish" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Publishing validates the complete draft and makes it active as one version.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="policy.publish"><input type="hidden" name="request_id" data-request-id><label>Optional expiry time<input name="expires_at" inputmode="numeric" placeholder="Unix timestamp; leave empty for no expiry"></label><button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Publish the current ACL draft?">Validate and publish</button></div></div>{{/can_policy_admin}}
    <div class="table-wrap"><table class="acl-rule-table"><thead><tr><th>Ordinal</th><th>User</th><th>Connection</th><th>Topic permissions</th><th>Placeholders</th><th class="actions-column">Actions</th></tr></thead><tbody>
      {{#rules}}<tr class="acl-rule-row"><td class="acl-rule__ordinal">{{ordinal}}</td><td class="acl-rule__subject"><code>{{subject_label}}</code></td><td class="acl-rule__decision">{{connection_label}}</td><td>{{entry_count}} statements · {{expanded_topic_count}} rules<details class="acl-document"><summary>View document</summary><pre>{{rule_line}}</pre></details></td><td>{{#uses_username}}<code>%u</code> username{{/uses_username}}{{#uses_client_id}}{{#uses_username}}<br>{{/uses_username}}<code>%c</code> client ID{{/uses_client_id}}{{^uses_username}}{{^uses_client_id}}Static{{/uses_client_id}}{{/uses_username}}</td><td class="table-actions">{{#can_policy_admin}}<button type="button" class="button--quiet" popovertarget="acl-edit-{{row_index}}">Edit</button><button type="button" class="button--quiet button--danger-text" popovertarget="acl-delete-{{row_index}}">Delete</button>{{/can_policy_admin}}{{^can_policy_admin}}<span class="muted">View only</span>{{/can_policy_admin}}
        {{#can_policy_admin}}<div id="acl-edit-{{row_index}}" class="control-popover control-popover--wide" popover><div class="popover-heading"><div><p class="eyebrow">{{subject_label}}</p><h3>Edit user ACL</h3></div><button type="button" class="button--close" popovertarget="acl-edit-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="policy.rule.put"><input type="hidden" name="ordinal" value="{{ordinal}}"><input type="hidden" name="request_id" data-request-id><div data-acl-builder-host data-domain="{{domain_id}}" data-current-rule="{{rule_line}}"></div><button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Save ACL</button></div></div>
        <div id="acl-delete-{{row_index}}" class="control-popover control-popover--danger" popover><div class="popover-heading"><div><p class="eyebrow">{{subject_label}}</p><h3>Delete user ACL</h3></div><button type="button" class="button--close" popovertarget="acl-delete-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="muted">This removes the complete user ACL from the draft. The active policy is unchanged until publication.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="policy.rule.delete"><input type="hidden" name="ordinal" value="{{ordinal}}"><input type="hidden" name="request_id" data-request-id><button type="button" class="button--danger" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Delete this user ACL from the draft?">Delete from draft</button></div></div>{{/can_policy_admin}}
      </td></tr>{{/rules}}
      {{^rules}}<tr><td colspan="6" class="empty">No user ACLs in the draft.{{#can_policy_admin}} Add a user ACL to begin.{{/can_policy_admin}}</td></tr>{{/rules}}
    </tbody></table></div>
    <div class="dataset-footer"><div class="pager" role="group" aria-label="User ACL pagination"><span class="pager__status">{{policy_pager.count}} shown</span>{{#policy_pager.first}}<button type="button" class="button--quiet" hx-get="{{policy_pager.first_url}}" hx-select="#acl-rules" hx-target="#acl-rules" hx-swap="outerHTML">First page</button>{{/policy_pager.first}}{{^policy_pager.first}}<button type="button" class="button--quiet" disabled>First page</button>{{/policy_pager.first}}{{#policy_pager.more}}<button type="button" class="button--quiet" hx-get="{{policy_pager.more_url}}" hx-select="#acl-rules" hx-target="#acl-rules" hx-swap="outerHTML">Next page</button>{{/policy_pager.more}}{{^policy_pager.more}}<button type="button" class="button--quiet" disabled>Next page</button>{{/policy_pager.more}}</div></div>
  </section>{{/show_acls}}

  {{#show_audit}}
  <section id="audit" class="dataset" aria-labelledby="audit-title">
    <div class="section-heading"><div><p class="eyebrow">Trace</p><h2 id="audit-title">Audit</h2></div><div class="dataset-toolbar" role="group" aria-label="Audit tools"><button type="button" class="button--quiet" popovertarget="audit-query">Query</button></div></div>
    <div id="audit-query" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">Audit</p><h3>Query from cursor</h3></div><button type="button" class="button--close" popovertarget="audit-query" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><div class="query-panel"><label>Continue after cursor<input name="audit_after" required inputmode="numeric"></label><button type="button" hx-get="{{audit_pager.query_url}}" hx-include="closest .query-panel" hx-select="#audit" hx-target="#audit" hx-swap="outerHTML" hx-disabled-elt="this">Query audit</button></div></div>
    <div class="table-wrap"><table><thead><tr><th>Actor</th><th>Operation</th><th>Target</th></tr></thead><tbody>{{#audits}}<tr><td>{{actor}}</td><td>{{operation}}</td><td>{{target_id}}</td></tr>{{/audits}}{{^audits}}<tr><td colspan="3" class="empty">No audit entries yet.</td></tr>{{/audits}}</tbody></table></div>
    <div class="dataset-footer"><div class="pager" role="group" aria-label="Audit pagination"><span class="pager__status">{{audit_pager.count}} shown</span>{{#audit_pager.first}}<button type="button" class="button--quiet" hx-get="{{audit_pager.first_url}}" hx-select="#audit" hx-target="#audit" hx-swap="outerHTML">First page</button>{{/audit_pager.first}}{{^audit_pager.first}}<button type="button" class="button--quiet" disabled>First page</button>{{/audit_pager.first}}{{#audit_pager.more}}<button type="button" class="button--quiet" hx-get="{{audit_pager.more_url}}" hx-select="#audit" hx-target="#audit" hx-swap="outerHTML">Next page</button>{{/audit_pager.more}}{{^audit_pager.more}}<button type="button" class="button--quiet" disabled>Next page</button>{{/audit_pager.more}}</div></div>
  </section>
  {{/show_audit}}
  </div>
</div>
