<div class="dashboard__inner">
  <nav class="dashboard-nav" aria-label="Control sections">
    <div class="dashboard-nav__group">
      <p class="dashboard-nav__label">Workspace</p>
      <a href="{{overview_path}}"{{#is_overview}} aria-current="page"{{/is_overview}}>Overview</a>
    </div>
    <div class="dashboard-nav__group">
      <p class="dashboard-nav__label">Records</p>
      <a href="{{users_path}}"{{#is_users}} aria-current="page"{{/is_users}}>Users</a>
      <a href="{{groups_path}}"{{#is_groups}} aria-current="page"{{/is_groups}}>Groups</a>
      <a href="{{roles_path}}"{{#is_roles}} aria-current="page"{{/is_roles}}>Roles</a>
      <a href="{{acls_path}}"{{#is_acls}} aria-current="page"{{/is_acls}}>ACL rules</a>
      {{#can_audit_read}}<a href="{{audit_path}}"{{#is_audit}} aria-current="page"{{/is_audit}}>Audit</a>{{/can_audit_read}}
    </div>
  </nav>

  <div class="dashboard__content">
  {{#can_select_root}}<form class="root-scope" hx-get="/v1/management/dashboard/content" hx-trigger="change from:#root-group-scope" hx-target="#dashboard" hx-swap="innerHTML">
    <label for="root-group-scope">Root Group</label>
    <input id="root-group-scope" name="root_group_id" list="root-groups" value="{{root_group_id}}" required maxlength="255" aria-label="Root Group">
    <datalist id="root-groups">{{#root_groups}}<option value="{{root_group_id}}"></option>{{/root_groups}}</datalist>
  </form>{{/can_select_root}}
  <div id="dashboard-feedback" class="feedback" aria-live="polite"></div>
  <template id="user-picker-options">{{#user_options}}<button type="button" class="entity-picker__option" data-picker-option data-value="{{principal_id}}" role="option" aria-selected="false"{{^enabled}} disabled{{/enabled}}><span>{{principal_id}}</span><small>{{principal_type}}</small></button>{{/user_options}}{{^user_options}}<p class="empty">No users</p>{{/user_options}}</template>
  <template id="group-picker-options">{{#group_options}}<button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{group_id}}" role="option" aria-selected="false"{{^enabled}} disabled{{/enabled}}><span>{{tree_label}}</span><small>{{#is_root}}Root group{{/is_root}}{{^is_root}}Group{{/is_root}}</small></button>{{/group_options}}{{^group_options}}<p class="empty">No groups</p>{{/group_options}}</template>
  <template id="group-member-picker-options">{{#group_options}}<button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{group_id}}" role="option" aria-selected="false"{{#add_disabled}} disabled{{/add_disabled}}><span>{{tree_label}}</span><small>{{#is_root}}Root group{{/is_root}}{{^is_root}}Group{{/is_root}}</small></button>{{/group_options}}{{^group_options}}<p class="empty">No groups</p>{{/group_options}}</template>
  <template id="group-parent-picker-options">{{#group_options}}<button type="button" class="entity-picker__option entity-picker__option--tree" data-picker-option data-value="{{group_id}}" role="option" aria-selected="false"{{#parent_disabled}} disabled{{/parent_disabled}}><span>{{tree_label}}</span><small>{{#is_root}}Root group{{/is_root}}{{^is_root}}Group{{/is_root}}</small></button>{{/group_options}}{{^group_options}}<p class="empty">No groups</p>{{/group_options}}</template>
  <template id="role-picker-options">{{#role_options}}<button type="button" class="entity-picker__option" data-picker-option data-value="{{role_id}}" role="option" aria-selected="false"{{^enabled}} disabled{{/enabled}}><span>{{role_id}}</span><small>Role</small></button>{{/role_options}}{{^role_options}}<p class="empty">No roles</p>{{/role_options}}</template>
  <template id="acl-builder-template">
    <div class="acl-builder" data-acl-builder>
      <section class="acl-examples" aria-labelledby="acl-examples-title"><h4 id="acl-examples-title">Start from an example</h4><div class="acl-examples__list"><button type="button" class="button--quiet" data-acl-example="subscribe-events">Allow event subscriptions</button><button type="button" class="button--quiet" data-acl-example="publish-events">Allow event publishing</button><button type="button" class="button--quiet" data-acl-example="deny-private">Block private topics</button></div></section>
      <div class="acl-builder__grid">
        <label>Decision<select data-acl-effect><option value="allow">Allow access</option><option value="deny">Deny access</option></select></label>
        <label>Who does this apply to?<select data-acl-subject><option value="any:*">Anyone in this root group</option><optgroup label="Users">{{#user_options}}<option value="principal:{{principal_id}}"{{^enabled}} disabled{{/enabled}}>User · {{principal_id}}</option>{{/user_options}}</optgroup><optgroup label="Group tree">{{#group_options}}<option value="group:{{group_id}}"{{^enabled}} disabled{{/enabled}}>Group · {{tree_label}}</option>{{/group_options}}</optgroup><optgroup label="Roles">{{#role_options}}<option value="role:{{role_id}}"{{^enabled}} disabled{{/enabled}}>Role · {{role_id}}</option>{{/role_options}}</optgroup></select></label>
        <fieldset class="acl-actions"><legend>Allowed operation(s)</legend><label><input type="checkbox" value="connect" data-acl-action> Connect</label><label><input type="checkbox" value="publish" data-acl-action> Publish</label><label><input type="checkbox" value="subscribe" data-acl-action> Subscribe</label><label><input type="checkbox" value="read" data-acl-action> Read</label><label><input type="checkbox" value="write" data-acl-action> Write</label><label><input type="checkbox" value="execute" data-acl-action> Execute</label><label><input type="checkbox" value="admin" data-acl-action> Admin</label></fieldset>
        <label>Resource type<select data-acl-resource><option value="mqtt_topic">MQTT topic</option><option value="generic">Generic resource</option><option value="flow_resource">Flow resource</option><option value="sql_object">SQL object</option><option value="secret">Secret</option></select></label>
        <label>Match behavior<select data-acl-match><option value="adapter">Protocol-aware match</option><option value="exact">Exact value</option><option value="prefix">Prefix</option></select></label>
        <label class="acl-builder__pattern">Resource path or pattern<input data-acl-pattern required maxlength="1024" placeholder="root-group/events/#"></label>
      </div>
      <div class="acl-preview"><span>Rule preview</span><output data-acl-preview></output></div>
      <input type="hidden" name="rule_line" data-acl-rule required>
    </div>
  </template>

  {{#show_overview}}<section id="overview" class="summary" aria-labelledby="summary-title">
    <div class="section-heading">
      <div><p class="eyebrow">Current state</p><h2 id="summary-title">Policy overview</h2></div>
      <span class="scope">Root: {{root_group_id}} · User: {{actor}}</span>
    </div>
    <dl class="metrics">
      <div><dt>Store revision</dt><dd>{{store_revision}}</dd></div>
      <div><dt>Policy version</dt><dd>{{policy_version}}</dd></div>
      <div><dt>Draft rules</dt><dd>{{draft_rule_count}}</dd></div>
      <div><dt>Published rules</dt><dd>{{published_rule_count}}</dd></div>
    </dl>
  </section>{{/show_overview}}

  {{#show_users}}<section id="users" class="dataset" aria-labelledby="users-title">
    <div class="section-heading">
      <div><p class="eyebrow">Directory</p><h2 id="users-title">Users</h2></div>
      <div class="dataset-toolbar" role="group" aria-label="Users tools">
        <button type="button" class="button--quiet" popovertarget="users-query">Query</button>
        {{#can_user_admin}}<button type="button" popovertarget="users-add">Add</button>{{/can_user_admin}}
      </div>
    </div>
    <div id="users-query" class="control-popover" popover>
      <div class="popover-heading"><div><p class="eyebrow">Users</p><h3>Query from cursor</h3></div><button type="button" class="button--close" popovertarget="users-query" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div>
      <div class="query-panel">
        <label>Start after user ID<input name="users_after" required maxlength="255"></label>
        <button type="button" hx-get="{{users_pager.query_url}}" hx-include="closest .query-panel" hx-select="#users" hx-target="#users" hx-swap="outerHTML" hx-disabled-elt="this">Query users</button>
      </div>
    </div>
    {{#can_user_admin}}
    <div id="users-add" class="control-popover" popover>
      <div class="popover-heading"><div><p class="eyebrow">Users</p><h3>Add user</h3></div><button type="button" class="button--close" popovertarget="users-add" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div>
      <div class="command command--compact">
        <input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="user.create"><input type="hidden" name="expected_revision" value="{{store_revision}}">
        <label>User ID<input name="principal_id" required maxlength="255"></label>
        <label>Type<input name="principal_type" required maxlength="63"></label>
        <input type="hidden" name="request_id" data-request-id>
        <button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Add user</button>
      </div>
    </div>
    {{/can_user_admin}}
    <div class="table-wrap"><table><thead><tr><th>ID</th><th>Type</th><th>Status</th><th>Revision</th><th class="actions-column">Actions</th></tr></thead><tbody>
      {{#users}}<tr><td>{{principal_id}}</td><td>{{principal_type}}</td><td>{{#enabled}}Enabled{{/enabled}}{{^enabled}}Disabled{{/enabled}}</td><td>{{revision}}</td><td class="table-actions">
        {{#can_manage_access}}<button type="button" class="button--quiet" popovertarget="user-access-{{row_index}}">Manage access</button>{{/can_manage_access}}
        {{#can_user_admin}}{{#enabled}}<button type="button" class="button--quiet button--danger-text" popovertarget="user-delete-{{row_index}}">Delete</button>{{/enabled}}{{^enabled}}<button type="button" class="button--quiet" disabled>Delete</button>{{/enabled}}{{/can_user_admin}}
        {{^can_manage_access}}{{^can_user_admin}}<span class="muted">View only</span>{{/can_user_admin}}{{/can_manage_access}}
        {{#can_manage_access}}
        <div id="user-access-{{row_index}}" class="control-popover control-popover--wide" popover>
          <div class="popover-heading"><div><p class="eyebrow">{{principal_id}}</p><h3>Manage user access</h3></div><button type="button" class="button--close" popovertarget="user-access-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div>
          <p class="task-hint">Choose a group or role from the directory, review the selection, then apply the required action.</p>
          <div class="command-grid">
            {{#can_user_admin}}<section class="access-task" data-entity-picker><h4>Group membership</h4><p class="muted">Membership inherits access from parent groups.</p><div class="entity-picker__pane"><h4>Group tree</h4><div class="entity-picker__list" data-picker-options="group-member-picker-options" role="listbox" aria-label="Group tree"></div></div><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No group selected</output><div class="task-actions"><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.member.add"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="group_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Add to group</button></div><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.member.remove"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="group_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" class="button--secondary" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Remove from group</button></div></div></section>{{/can_user_admin}}
            {{#can_security_admin}}<section class="access-task" data-entity-picker><h4>Role assignment</h4><p class="muted">Roles grant the permissions defined by ACL rules.</p><div class="entity-picker__pane"><h4>Available roles</h4><div class="entity-picker__list" data-picker-options="role-picker-options" role="listbox" aria-label="Available roles"></div></div><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No role selected</output>{{#role_options_truncated}}<p class="notice-inline">Only the first 100 roles are available.</p>{{/role_options_truncated}}<div class="task-actions"><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.assign"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="role_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Assign role</button></div><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.remove"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="role_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" class="button--secondary" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Remove role</button></div></div></section>{{/can_security_admin}}
          </div>
        </div>
        {{/can_manage_access}}
        {{#can_user_admin}}{{#enabled}}<div id="user-delete-{{row_index}}" class="control-popover control-popover--danger" popover><div class="popover-heading"><div><p class="eyebrow">{{principal_id}}</p><h3>Delete user</h3></div><button type="button" class="button--close" popovertarget="user-delete-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="muted">This disables sign-in while retaining audit history.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="user.disable"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="principal_id" value="{{principal_id}}"><input type="hidden" name="request_id" data-request-id><button type="button" class="button--danger" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Disable this user?">Disable user</button></div></div>{{/enabled}}{{/can_user_admin}}
      </td></tr>{{/users}}
      {{^users}}<tr><td colspan="5" class="empty">No users</td></tr>{{/users}}
    </tbody></table></div>
    <div class="dataset-footer"><div class="pager" role="group" aria-label="Users pagination"><span class="pager__status">{{users_pager.count}} shown</span>{{#users_pager.first}}<button type="button" class="button--quiet" hx-get="{{users_pager.first_url}}" hx-select="#users" hx-target="#users" hx-swap="outerHTML">First page</button>{{/users_pager.first}}{{^users_pager.first}}<button type="button" class="button--quiet" disabled>First page</button>{{/users_pager.first}}{{#users_pager.more}}<button type="button" class="button--quiet" hx-get="{{users_pager.more_url}}" hx-select="#users" hx-target="#users" hx-swap="outerHTML">Next page</button>{{/users_pager.more}}{{^users_pager.more}}<button type="button" class="button--quiet" disabled>Next page</button>{{/users_pager.more}}</div></div>
  </section>{{/show_users}}

  {{#show_groups}}<section id="groups" class="dataset" aria-labelledby="groups-title">
    <div class="section-heading"><div><p class="eyebrow">Hierarchy</p><h2 id="groups-title">Groups</h2></div><div class="dataset-toolbar" role="group" aria-label="Groups tools">{{#can_user_admin}}<button type="button" popovertarget="groups-add">Add</button>{{/can_user_admin}}</div></div>
    {{#can_user_admin}}<div id="groups-add" class="control-popover control-popover--wide" popover><div class="popover-heading"><div><p class="eyebrow">Groups</p><h3>Create a child group</h3></div><button type="button" class="button--close" popovertarget="groups-add" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Select where the group belongs in the hierarchy, then give the new group a unique ID.</p><div class="command command--compact" data-entity-picker><div class="entity-picker"><section class="entity-picker__pane"><h4>Parent group tree</h4><div class="entity-picker__list" data-picker-options="group-parent-picker-options" role="listbox" aria-label="Parent group tree"></div></section><section class="entity-picker__pane entity-picker__pane--target"><h4>Selected parent</h4><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No parent selected</output></section></div><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.create"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="parent_group_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><label>New group ID<input name="group_id" required maxlength="255" placeholder="for example: operations-east"></label><button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Create child group</button></div></div>{{/can_user_admin}}
    <div class="table-wrap"><table><thead><tr><th>Group tree</th><th>Parent</th><th>Status</th><th class="actions-column">Actions</th></tr></thead><tbody>
      {{#group_options}}<tr><td><span class="tree-node" data-depth="{{depth}}">{{tree_label}}</span></td><td>{{parent_group_id}}</td><td>{{#enabled}}Enabled{{/enabled}}{{^enabled}}Disabled{{/enabled}}</td><td class="table-actions">{{#can_user_admin}}{{#member_allowed}}<button type="button" class="button--quiet" popovertarget="group-members-{{row_index}}">Members</button>{{/member_allowed}}{{^member_allowed}}<button type="button" class="button--quiet" disabled title="Memberships require an enabled non-root group">Members</button>{{/member_allowed}}{{#delete_candidate}}<button type="button" class="button--quiet button--danger-text" popovertarget="group-delete-{{row_index}}">Delete</button>{{/delete_candidate}}{{^delete_candidate}}<button type="button" class="button--quiet" disabled title="Only an enabled leaf group can be deleted">Delete</button>{{/delete_candidate}}{{/can_user_admin}}{{^can_user_admin}}<span class="muted">View only</span>{{/can_user_admin}}
        {{#can_user_admin}}{{#member_allowed}}<div id="group-members-{{row_index}}" class="control-popover control-popover--wide" popover><div class="popover-heading"><div><p class="eyebrow">{{group_id}}</p><h3>Add a user to this group</h3></div><button type="button" class="button--close" popovertarget="group-members-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Choose a user from the directory. The target group is fixed to <strong>{{group_id}}</strong>.</p><div class="command command--compact" data-entity-picker><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.member.add"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="group_id" value="{{group_id}}"><input type="hidden" name="principal_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><div class="entity-picker"><section class="entity-picker__pane" aria-labelledby="group-users-{{row_index}}"><h4 id="group-users-{{row_index}}">All users</h4><div class="entity-picker__list" data-picker-options="user-picker-options" role="listbox" aria-label="All users"></div></section><section class="entity-picker__pane entity-picker__pane--target"><h4>Target group</h4><p class="entity-picker__target-name">{{group_id}}</p><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No user selected</output></section></div>{{#user_options_truncated}}<p class="notice-inline">Only the first 100 users are available. Use the Users page for other assignments.</p>{{/user_options_truncated}}<button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Add selected user</button></div></div>{{/member_allowed}}
        {{#delete_candidate}}<div id="group-delete-{{row_index}}" class="control-popover control-popover--danger" popover><div class="popover-heading"><div><p class="eyebrow">{{group_id}}</p><h3>Delete group</h3></div><button type="button" class="button--close" popovertarget="group-delete-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="muted">Only an empty leaf group can be deleted. Remove memberships and ACL references first.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="group.disable"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="group_id" value="{{group_id}}"><input type="hidden" name="request_id" data-request-id><button type="button" class="button--danger" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Delete this empty group?">Delete empty group</button></div></div>{{/delete_candidate}}
        {{/can_user_admin}}
      </td></tr>{{/group_options}}
      {{^group_options}}<tr><td colspan="4" class="empty">No groups</td></tr>{{/group_options}}
    </tbody></table></div>
  </section>{{/show_groups}}

  {{#show_roles}}<section id="roles" class="dataset" aria-labelledby="roles-title">
    <div class="section-heading"><div><p class="eyebrow">Authorization</p><h2 id="roles-title">Roles</h2></div><div class="dataset-toolbar" role="group" aria-label="Roles tools"><button type="button" class="button--quiet" popovertarget="roles-query">Query</button>{{#can_security_admin}}<button type="button" popovertarget="roles-add">Add</button>{{/can_security_admin}}</div></div>
    <div id="roles-query" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">Roles</p><h3>Query from cursor</h3></div><button type="button" class="button--close" popovertarget="roles-query" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><div class="query-panel"><label>Start after role ID<input name="roles_after" required maxlength="63"></label><button type="button" hx-get="{{roles_pager.query_url}}" hx-include="closest .query-panel" hx-select="#roles" hx-target="#roles" hx-swap="outerHTML" hx-disabled-elt="this">Query roles</button></div></div>
    {{#can_security_admin}}<div id="roles-add" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">Roles</p><h3>Create role</h3></div><button type="button" class="button--close" popovertarget="roles-add" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Create a named role, then reference it from ACL rules and assign users from the role directory.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.create"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="request_id" data-request-id><label>Role name<input name="role_id" required maxlength="63" placeholder="for example: event-publisher"></label><button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Create role</button></div></div>{{/can_security_admin}}
    <div class="table-wrap"><table><thead><tr><th>ID</th><th>Status</th><th>Revision</th><th class="actions-column">Actions</th></tr></thead><tbody>
      {{#roles}}<tr><td>{{role_id}}</td><td>{{#enabled}}Enabled{{/enabled}}{{^enabled}}Disabled{{/enabled}}</td><td>{{revision}}</td><td class="table-actions">{{#can_security_admin}}<button type="button" class="button--quiet" popovertarget="role-assignments-{{row_index}}">Assignments</button>{{#enabled}}<button type="button" class="button--quiet button--danger-text" popovertarget="role-delete-{{row_index}}">Delete</button>{{/enabled}}{{^enabled}}<button type="button" class="button--quiet" disabled>Delete</button>{{/enabled}}{{/can_security_admin}}{{^can_security_admin}}<span class="muted">View only</span>{{/can_security_admin}}
        {{#can_security_admin}}<div id="role-assignments-{{row_index}}" class="control-popover control-popover--wide" popover><div class="popover-heading"><div><p class="eyebrow">{{role_id}}</p><h3>Manage role assignments</h3></div><button type="button" class="button--close" popovertarget="role-assignments-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Choose a user from the directory, then assign or remove this role.</p><div data-entity-picker><div class="entity-picker"><section class="entity-picker__pane" aria-labelledby="role-users-{{row_index}}"><h4 id="role-users-{{row_index}}">All users</h4><div class="entity-picker__list" data-picker-options="user-picker-options" role="listbox" aria-label="All users"></div></section><section class="entity-picker__pane entity-picker__pane--target"><h4>Target role</h4><p class="entity-picker__target-name">{{role_id}}</p><output class="entity-picker__selection entity-picker__selection--empty" data-picker-output>No user selected</output></section></div>{{#user_options_truncated}}<p class="notice-inline">Only the first 100 users are available. Use the Users page for other assignments.</p>{{/user_options_truncated}}<div class="task-actions"><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.assign"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="role_id" value="{{role_id}}"><input type="hidden" name="principal_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Assign selected user</button></div><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.remove"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="role_id" value="{{role_id}}"><input type="hidden" name="principal_id" data-picker-target required><input type="hidden" name="request_id" data-request-id><button type="button" class="button--secondary" data-picker-action disabled hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Remove selected user</button></div></div></div></div>
        {{#enabled}}<div id="role-delete-{{row_index}}" class="control-popover control-popover--danger" popover><div class="popover-heading"><div><p class="eyebrow">{{role_id}}</p><h3>Delete role</h3></div><button type="button" class="button--close" popovertarget="role-delete-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="muted">Remove ACL references first. Deleting the role disables it and revokes any remaining user assignments.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="role.disable"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="role_id" value="{{role_id}}"><input type="hidden" name="request_id" data-request-id><button type="button" class="button--danger" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Disable this role and revoke remaining assignments?">Disable role</button></div></div>{{/enabled}}{{/can_security_admin}}
      </td></tr>{{/roles}}
      {{^roles}}<tr><td colspan="4" class="empty">No roles</td></tr>{{/roles}}
    </tbody></table></div>
