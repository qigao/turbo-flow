  </section>{{/show_roles}}

  {{#show_acls}}<section id="acl-rules" class="dataset" aria-labelledby="policy-title">
    <div class="section-heading"><div><p class="eyebrow">Draft</p><h2 id="policy-title">ACL rules</h2></div><div class="dataset-toolbar" role="group" aria-label="ACL rules tools"><button type="button" class="button--quiet" popovertarget="acl-query">Query</button>{{#can_policy_admin}}<button type="button" popovertarget="acl-add">Add</button><button type="button" class="button--secondary" popovertarget="acl-publish">Publish</button>{{/can_policy_admin}}</div></div>
    <div id="acl-query" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">ACL rules</p><h3>Query from cursor</h3></div><button type="button" class="button--close" popovertarget="acl-query" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><div class="query-panel"><label>Start after ordinal<input name="policy_after" required inputmode="numeric"></label><button type="button" hx-get="{{policy_pager.query_url}}" hx-include="closest .query-panel" hx-select="#acl-rules" hx-target="#acl-rules" hx-swap="outerHTML" hx-disabled-elt="this">Query rules</button></div></div>
    {{#can_policy_admin}}<div id="acl-add" class="control-popover control-popover--wide" popover><div class="popover-heading"><div><p class="eyebrow">ACL rules</p><h3>Create an access rule</h3></div><button type="button" class="button--close" popovertarget="acl-add" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Choose an example or describe who can do what. The technical rule expression is generated automatically.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="policy.rule.put"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="request_id" data-request-id><label>Evaluation order<input name="ordinal" required inputmode="numeric" min="0" placeholder="for example: 10"><small>Lower numbers are evaluated first.</small></label><div data-acl-builder-host data-root-group="{{root_group_id}}"></div><button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Add rule to draft</button></div></div>
    <div id="acl-publish" class="control-popover" popover><div class="popover-heading"><div><p class="eyebrow">ACL rules</p><h3>Publish policy</h3></div><button type="button" class="button--close" popovertarget="acl-publish" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Publishing validates the complete draft and makes it active as one version.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="policy.publish"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="request_id" data-request-id><label>Optional expiry time<input name="expires_at" inputmode="numeric" placeholder="Unix timestamp; leave empty for no expiry"></label><button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Publish the current ACL draft?">Validate and publish</button></div></div>{{/can_policy_admin}}
    <div class="table-wrap"><table><thead><tr><th>Ordinal</th><th>Resource tree</th><th>Revision</th><th class="actions-column">Actions</th></tr></thead><tbody>
      {{#rules}}<tr><td>{{ordinal}}</td><td><div class="resource-tree"><span class="resource-tree__kind">{{#is_mqtt_topic}}MQTT topic{{/is_mqtt_topic}}{{^is_mqtt_topic}}Resource{{/is_mqtt_topic}}</span><code class="resource-tree__path">{{resource_label}}</code><details><summary>Canonical rule</summary><code>{{rule_line}}</code></details></div></td><td>{{revision}}</td><td class="table-actions">{{#can_policy_admin}}<button type="button" class="button--quiet" popovertarget="acl-edit-{{row_index}}">Edit</button><button type="button" class="button--quiet button--danger-text" popovertarget="acl-delete-{{row_index}}">Delete</button>{{/can_policy_admin}}{{^can_policy_admin}}<span class="muted">View only</span>{{/can_policy_admin}}
        {{#can_policy_admin}}<div id="acl-edit-{{row_index}}" class="control-popover control-popover--wide" popover><div class="popover-heading"><div><p class="eyebrow">Evaluation order {{ordinal}}</p><h3>Edit access rule</h3></div><button type="button" class="button--close" popovertarget="acl-edit-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="task-hint">Change the understandable fields below; the canonical rule is regenerated before saving.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="policy.rule.put"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="ordinal" value="{{ordinal}}"><input type="hidden" name="request_id" data-request-id><div data-acl-builder-host data-root-group="{{root_group_id}}" data-current-rule="{{rule_line}}"></div><button type="button" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this">Save rule changes</button></div></div>
        <div id="acl-delete-{{row_index}}" class="control-popover control-popover--danger" popover><div class="popover-heading"><div><p class="eyebrow">Evaluation order {{ordinal}}</p><h3>Delete access rule</h3></div><button type="button" class="button--close" popovertarget="acl-delete-{{row_index}}" popovertargetaction="hide" aria-label="Close" title="Close">x</button></div><p class="muted">This removes the rule from the draft. The active policy is unchanged until the draft is published.</p><div class="command command--compact"><input type="hidden" name="csrf" value="{{csrf}}"><input type="hidden" name="operation" value="policy.rule.delete"><input type="hidden" name="expected_revision" value="{{store_revision}}"><input type="hidden" name="ordinal" value="{{ordinal}}"><input type="hidden" name="request_id" data-request-id><button type="button" class="button--danger" hx-post="{{action_url}}" hx-include="closest .command" hx-target="#dashboard" hx-swap="innerHTML" hx-disabled-elt="this" hx-confirm="Delete this ACL rule from the draft?">Delete from draft</button></div></div>{{/can_policy_admin}}
      </td></tr>{{/rules}}
      {{^rules}}<tr><td colspan="4" class="empty">No draft rules</td></tr>{{/rules}}
    </tbody></table></div>
    <div class="dataset-footer"><div class="pager" role="group" aria-label="ACL rules pagination"><span class="pager__status">{{policy_pager.count}} shown</span>{{#policy_pager.first}}<button type="button" class="button--quiet" hx-get="{{policy_pager.first_url}}" hx-select="#acl-rules" hx-target="#acl-rules" hx-swap="outerHTML">First page</button>{{/policy_pager.first}}{{^policy_pager.first}}<button type="button" class="button--quiet" disabled>First page</button>{{/policy_pager.first}}{{#policy_pager.more}}<button type="button" class="button--quiet" hx-get="{{policy_pager.more_url}}" hx-select="#acl-rules" hx-target="#acl-rules" hx-swap="outerHTML">Next page</button>{{/policy_pager.more}}{{^policy_pager.more}}<button type="button" class="button--quiet" disabled>Next page</button>{{/policy_pager.more}}</div></div>
  </section>{{/show_acls}}

