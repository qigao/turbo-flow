server {
    listen 80;
    server_name ${FLOWIE_PUBLIC_HOST};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok\n';
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${FLOWIE_PUBLIC_HOST};

    ssl_certificate /etc/letsencrypt/live/${FLOWIE_PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${FLOWIE_PUBLIC_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:FLOWIE_HTTPS:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    location = / {
        return 303 /v2/control/dashboard;
    }

    location / {
        proxy_pass https://${FLOWIE_CONTROL_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_ssl_server_name on;
        proxy_ssl_name ${FLOWIE_CONTROL_TLS_NAME};
        proxy_ssl_trusted_certificate /etc/flowie/internal-ca.pem;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
