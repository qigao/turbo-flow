FLOWIE_PUBLIC_HOST=mqtt.dev.my-photo.xyz
FLOWIE_CERTBOT_EMAIL=ops@example.com
FLOWIE_CONTROL_UPSTREAM=127.0.0.1:8443
FLOWIE_CONTROL_TLS_NAME=flowie-control.internal
FLOWIE_MQTT_BACKENDS=127.0.0.1:18883
FLOWIE_MQTT_PUBLIC_PORT=8883
FLOWIE_MQTT_INSPECT_DELAY_MS=5000
FLOWIE_MQTT_INSPECTION_BUFFER_BYTES=32768
FLOWIE_MQTT_CONNECT_TIMEOUT_MS=5000
FLOWIE_MQTT_IDLE_TIMEOUT_SECONDS=3600
FLOWIE_HAPROXY_CERT_POLL_SECONDS=300
FLOWIE_INTERNAL_CA_FILE=./state/internal-ca.pem
FLOWIE_LETSENCRYPT_DIR=./state/letsencrypt
FLOWIE_ACME_WEBROOT_DIR=./state/acme
FLOWIE_HTTP_CONF_DIR=./http.d
FLOWIE_HTTP_ASSET_DIR=./http-assets
FLOWIE_CERTBOT_RENEW_INTERVAL=12h
