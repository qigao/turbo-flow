schema TurboFlowProtocolInbox [name("turbo-flow.protocol.inbox"), version(1), byte_order(little)];

enum ProtocolEnvelopeVersion <uint32> {
    V1 = 1;
}

enum ProtocolKind <uint32> {
    MqttSn = 1;
    Coap = 2;
    Lwm2m = 3;
    Ocpp = 4;
    Gbt32960 = 5;
    Jtt808 = 6;
}

enum ProtocolDirection <uint32> {
    Up = 1;
    Down = 2;
}

message ProtocolInboxEnvelope {
    ProtocolEnvelopeVersion envelopeVersion;
    ProtocolKind protocol;
    ProtocolDirection direction;
    uint32 messageType;
    uint64 sequence;
    string protocolVersion;
    string deviceId;
    string operation;
    string correlationId;
    bytes payload;
}
