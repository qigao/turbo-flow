schema Ocpp201Core [name("ocpp.2.0.1.core.minimal"), version(6), byte_order(little)];

enum BootReason <uint8> {
    ApplicationReset = 1;
    FirmwareUpdate = 2;
    LocalReset = 3;
    PowerUp = 4;
    RemoteReset = 5;
    ScheduledReset = 6;
    Triggered = 7;
    Unknown = 8;
    Watchdog = 9;
}

enum ResetType <uint8> {
    Immediate = 1;
    OnIdle = 2;
}

enum ConnectorStatus <uint8> {
    Available = 1;
    Occupied = 2;
    Reserved = 3;
    Unavailable = 4;
    Faulted = 5;
}

enum TransactionEventType <uint8> {
    Ended = 1;
    Started = 2;
    Updated = 3;
}

enum TriggerReason <uint8> {
    Authorized = 1;
    CablePluggedIn = 2;
    ChargingRateChanged = 3;
    ChargingStateChanged = 4;
    Deauthorized = 5;
    EnergyLimitReached = 6;
    EVCommunicationLost = 7;
    EVConnectTimeout = 8;
    MeterValueClock = 9;
    MeterValuePeriodic = 10;
    TimeLimitReached = 11;
    Trigger = 12;
    UnlockCommand = 13;
    StopAuthorized = 14;
    EVDeparted = 15;
    EVDetected = 16;
    RemoteStop = 17;
    RemoteStart = 18;
    AbnormalCondition = 19;
    SignedDataReceived = 20;
    ResetCommand = 21;
}

enum IdTokenType <uint8> {
    Central = 1;
    eMAID = 2;
    ISO14443 = 3;
    ISO15693 = 4;
    KeyCode = 5;
    Local = 6;
    MacAddress = 7;
    NoAuthorization = 8;
}

message ChargingStation {
    string model;
    string vendorName;
}

message BootNotificationReason {
    BootReason reason;
}

message ResetRequest {
    ResetType type;
}

message StatusNotificationRequest {
    ConnectorStatus connectorStatus;
    uint32 evseId;
    uint32 connectorId;
    string timestamp;
}

message UnlockConnectorRequest {
    uint32 evseId;
    uint32 connectorId;
}

message TransactionEventRequired {
    TransactionEventType eventType;
    TriggerReason triggerReason;
    uint32 seqNo;
    string timestamp;
}

message TransactionInfoRequired {
    string transactionId;
}

message TransactionOffline {
    bool offline;
}

message TransactionEvseRequired {
    uint32 id;
}

message TransactionEvseConnector {
    uint32 connectorId;
}

message TransactionIdToken {
    IdTokenType type;
    string idToken;
}

message TransactionEventFacts {
    TransactionEventType eventType;
    TriggerReason triggerReason;
    uint32 seqNo;
    optional bool offline;
    string timestamp;
}

message TransactionEvseFacts {
    uint32 id;
    optional uint32 connectorId;
}
