schema TurboFlowCHttpProviderConfig [version(1)];

enum CHttpClientProtocol <uint8> {
  H1 = 0;
  H2 = 1;
}

enum CHttpServerProtocol <uint8> {
  H1 = 0;
  H1_H2 = 1;
}

enum CHttpMethod <uint8> {
  GET = 0;
  POST = 1;
  PUT = 2;
  DELETE = 3;
  PATCH = 4;
  HEAD = 5;
  OPTIONS = 6;
}

message CHttpClientPolicy {
  @Min(1) @Max(1) uint32 schema_version;
  @Min(1) uint32 poll_budget_ms;
  bool idempotent;

  @Min(1) uint64 network_connection_capacity;
  @Min(1) uint64 network_command_capacity;
  @Min(1) uint64 network_request_capacity;
  @Min(1) uint64 network_completion_batch_capacity;
  @Min(2) uint64 network_event_capacity;
  @Min(1) uint64 network_max_send_bytes;
  @Min(1) uint64 network_receive_buffer_bytes;
  @Min(1) uint64 network_command_buffer_bytes;
  @Min(1) uint64 network_event_buffer_bytes;
  uint32 network_connect_timeout_ms;
  uint32 network_read_timeout_ms;
  uint32 network_write_timeout_ms;
  uint32 network_tls_handshake_timeout_ms;
  uint64 network_tls_io_buffer_bytes;

  @Min(1) uint64 request_capacity;
  @Min(1) uint64 max_start_line_bytes;
  @Min(1) uint64 max_header_count;
  @Min(1) uint64 max_header_bytes;
  @Min(1) uint64 max_request_body_bytes;
  @Min(1) uint64 max_response_body_bytes;
  @Min(1) uint64 max_informational_responses;
  @Min(1) uint64 stream_chunk_bytes;
  @Min(16393) uint64 h2_input_buffer_bytes;
  @Min(1) uint64 h2_hpack_dynamic_table_bytes;
  @Min(1) uint64 h2_max_settings_count;

  uint32 overall_timeout_ms;
  uint32 retry_delay_ms;
  @Min(1) uint32 max_attempts;
  @Min(1) uint32 stop_timeout_ms;

  CHttpClientProtocol protocol;
  @Size(min = 1, max = 511) string authority;
  @Size(min = 1, max = 511) string target;
  CHttpMethod method;
}

message CHttpServerPolicy {
  @Min(1) @Max(1) uint32 schema_version;
  @Min(1) uint32 poll_budget_ms;

  @Min(1) uint64 network_connection_capacity;
  @Min(1) uint64 network_command_capacity;
  @Min(1) uint64 network_request_capacity;
  @Min(1) uint64 network_completion_batch_capacity;
  @Min(2) uint64 network_event_capacity;
  @Min(1) uint64 network_max_send_bytes;
  @Min(1) uint64 network_receive_buffer_bytes;
  @Min(1) uint64 network_command_buffer_bytes;
  @Min(1) uint64 network_event_buffer_bytes;
  uint32 network_connect_timeout_ms;
  uint32 network_read_timeout_ms;
  uint32 network_write_timeout_ms;
  uint32 network_tls_handshake_timeout_ms;
  uint64 network_tls_io_buffer_bytes;

  @Min(1) uint64 backlog;
  @Min(1) uint64 route_capacity;
  @Min(1) uint64 max_target_bytes;
  @Min(1) uint64 max_header_count;
  @Min(1) uint64 max_header_bytes;
  @Min(1) uint64 max_request_body_bytes;
  @Min(1) uint64 max_response_header_count;
  @Min(1) uint64 max_response_header_bytes;
  @Min(1) uint64 max_response_body_bytes;
  @Min(1) uint64 stream_chunk_bytes;
  @Min(1) uint64 max_buffered_response_body_bytes;
  @Min(1) uint64 buffer_capacity_bytes;
  uint64 middleware_capacity;
  uint64 max_route_middleware_count;
  uint64 max_route_param_count;
  uint64 max_route_param_bytes;
  uint64 h2_stream_capacity;
  uint64 h2_input_buffer_bytes;
  uint64 h2_output_buffer_bytes;
  uint64 h2_hpack_dynamic_table_bytes;
  uint64 h2_max_settings_count;
  @Min(1) uint32 poll_slice_ms;

  @Min(1) uint64 max_request_message_bytes;
  @Min(200) @Max(599) uint32 success_status;
  @Min(200) @Max(599) uint32 overload_status;
  @Min(200) @Max(599) uint32 unavailable_status;
  @Min(200) @Max(599) uint32 graph_error_status;
  @Min(1) uint64 first_message_id;
  @Min(1) uint32 stop_timeout_ms;

  CHttpServerProtocol protocol;
  @Size(min = 1, max = 511) string path;
  CHttpMethod method;
  @Size(min = 1, max = 511) string response_content_type;
  @Size(min = 1, max = 511) string error_content_type;
  optional @Size(max = 511) string graph_error_body default "";
}

message CHttpWebSocketPolicy {
  @Min(1) @Max(1) uint32 schema_version;
  @Min(1) uint32 poll_budget_ms;

  @Min(1) uint64 network_connection_capacity;
  @Min(1) uint64 network_command_capacity;
  @Min(1) uint64 network_request_capacity;
  @Min(1) uint64 network_completion_batch_capacity;
  @Min(2) uint64 network_event_capacity;
  @Min(1) uint64 network_max_send_bytes;
  @Min(1) uint64 network_receive_buffer_bytes;
  @Min(1) uint64 network_command_buffer_bytes;
  @Min(1) uint64 network_event_buffer_bytes;
  uint32 network_connect_timeout_ms;
  uint32 network_read_timeout_ms;
  uint32 network_write_timeout_ms;
  uint32 network_tls_handshake_timeout_ms;
  uint64 network_tls_io_buffer_bytes;

  @Min(1) uint64 backlog;
  @Min(1) uint64 route_capacity;
  @Min(1) uint64 max_target_bytes;
  @Min(1) uint64 max_header_count;
  @Min(1) uint64 max_header_bytes;
  @Min(1) uint64 max_request_body_bytes;
  @Min(1) uint64 max_response_header_count;
  @Min(1) uint64 max_response_header_bytes;
  @Min(1) uint64 max_response_body_bytes;
  @Min(1) uint64 stream_chunk_bytes;
  @Min(1) uint64 max_buffered_response_body_bytes;
  @Min(1) uint64 buffer_capacity_bytes;
  uint64 middleware_capacity;
  uint64 max_route_middleware_count;
  uint64 max_route_param_count;
  uint64 max_route_param_bytes;
  uint64 h2_stream_capacity;
  uint64 h2_input_buffer_bytes;
  uint64 h2_output_buffer_bytes;
  uint64 h2_hpack_dynamic_table_bytes;
  uint64 h2_max_settings_count;
  @Min(1) uint32 poll_slice_ms;

  @Min(1) uint64 session_capacity;
  @Min(1) uint64 frame_capacity;
  @Min(1) uint64 max_frame_bytes;
  @Min(1) uint64 max_message_bytes;
  @Min(1) uint64 max_buffered_input_bytes;
  @Min(1) uint64 first_message_id;
  @Min(1) uint32 stop_timeout_ms;

  CHttpServerProtocol protocol;
  @Size(min = 1, max = 511) string path;
  optional @Size(max = 511) string subprotocol default "";
}
