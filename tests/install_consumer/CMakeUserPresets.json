{
  "version": 6,
  "include": ["../../CMakeUserPresets.json"],
  "configurePresets": [
    { "name": "consumer-win-dev-user", "inherits": "win-dev-user", "binaryDir": "${sourceDir}/build/win-dev-user", "environment": { "TURBO_FLOW_ROOT": "$env{PKG_ROOT}/turboflow/debug" }, "cacheVariables": { "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/win-dev-user/install" } },
    { "name": "consumer-win-release-user", "inherits": "win-release-user", "binaryDir": "${sourceDir}/build/win-release-user", "environment": { "TURBO_FLOW_ROOT": "$env{PKG_ROOT}/turboflow/release" }, "cacheVariables": { "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/win-release-user/install" } }
  ],
  "buildPresets": [
    { "name": "consumer-win-dev-user", "configurePreset": "consumer-win-dev-user" },
    { "name": "consumer-win-release-user", "configurePreset": "consumer-win-release-user" },
    { "name": "install-consumer-win-dev-user", "configurePreset": "consumer-win-dev-user", "targets": ["install"] },
    { "name": "install-consumer-win-release-user", "configurePreset": "consumer-win-release-user", "targets": ["install"] }
  ],
  "testPresets": [
    { "name": "consumer-win-dev-user", "inherits": "base-test", "configurePreset": "consumer-win-dev-user" },
    { "name": "consumer-win-release-user", "inherits": "base-test", "configurePreset": "consumer-win-release-user" }
  ]
}
