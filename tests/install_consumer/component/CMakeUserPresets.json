{
  "version": 6,
  "include": ["../../../CMakeUserPresets.json"],
  "configurePresets": [
    { "name": "component-win-dev-user", "inherits": "win-dev-user", "binaryDir": "${sourceDir}/build/win-dev-user", "environment": { "TURBO_FLOW_ROOT": "$env{PKG_ROOT}/turboflow/debug" } },
    { "name": "component-win-release-user", "inherits": "win-release-user", "binaryDir": "${sourceDir}/build/win-release-user", "environment": { "TURBO_FLOW_ROOT": "$env{PKG_ROOT}/turboflow/release" } }
  ],
  "buildPresets": [
    { "name": "component-win-dev-user", "configurePreset": "component-win-dev-user" },
    { "name": "component-win-release-user", "configurePreset": "component-win-release-user" }
  ],
  "testPresets": [
    { "name": "component-win-dev-user", "inherits": "base-test", "configurePreset": "component-win-dev-user" },
    { "name": "component-win-release-user", "inherits": "base-test", "configurePreset": "component-win-release-user" }
  ]
}
