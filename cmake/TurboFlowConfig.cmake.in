@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Salts CONFIG REQUIRED)
find_dependency(SaltsUtils CONFIG REQUIRED)
find_dependency(RulesForge 0.9 CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/TurboFlowTargets.cmake")

set(TurboFlow_Config_FOUND TRUE)
set(TurboFlow_Graph_FOUND TRUE)
set(TurboFlow_CNetAdapter_FOUND TRUE)
set(TurboFlow_Product_FOUND TRUE)
set(TurboFlow_Flow_FOUND TRUE)
set(TurboFlow_Codec_FOUND TRUE)
set(TurboFlow_Observe_FOUND TRUE)
set(TurboFlow_Schedule_FOUND TRUE)
check_required_components(TurboFlow)
