@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_TurboFlow_supported_components
    Config
    Graph
    CNetAdapter
    CHTTPAdapter
    Product
    Flow
    ProtocolIngress
    ProtocolIngressGraph
    ProtocolMqttSn
    ProtocolCoap
    ProtocolLwm2m
    ProtocolOcpp
    ProtocolGbt32960
    ProtocolJtt808
    ProtocolBusinessOcpp201Core
    MqttSink
    SecuritySQLite
    Codec
    Observe
    Schedule)

if(@TURBO_FLOW_HAS_TURBODB_ADAPTER@)
  list(APPEND _TurboFlow_supported_components TurboDbAdapter)
endif()

set(_TurboFlow_salts_utils_components
    Graph
    Product
    Flow
    ProtocolIngressGraph
    ProtocolBusinessOcpp201Core
    SecuritySQLite
    Codec
    Observe
    Schedule
    TurboDbAdapter)

set(_TurboFlow_rules_forge_components
    Graph
    Product
    Flow
    ProtocolIngressGraph
    SecuritySQLite
    Codec
    Observe
    Schedule
    TurboDbAdapter)

set(_TurboFlow_requested_components ${TurboFlow_FIND_COMPONENTS})
if(NOT _TurboFlow_requested_components)
  set(_TurboFlow_requested_components ${_TurboFlow_supported_components})
endif()

foreach(_TurboFlow_component IN LISTS TurboFlow_FIND_COMPONENTS)
  if(NOT _TurboFlow_component IN_LIST _TurboFlow_supported_components)
    set(TurboFlow_${_TurboFlow_component}_FOUND FALSE)
    set(TurboFlow_FOUND FALSE)
    set(TurboFlow_NOT_FOUND_MESSAGE
        "Unsupported TurboFlow component: ${_TurboFlow_component}")
    return()
  endif()
endforeach()

set(_TurboFlow_needs_salts_utils FALSE)
set(_TurboFlow_needs_rules_forge FALSE)
set(_TurboFlow_needs_turbodb FALSE)
foreach(_TurboFlow_component IN LISTS _TurboFlow_requested_components)
  if(_TurboFlow_component IN_LIST _TurboFlow_salts_utils_components)
    set(_TurboFlow_needs_salts_utils TRUE)
  endif()
  if(_TurboFlow_component IN_LIST _TurboFlow_rules_forge_components)
    set(_TurboFlow_needs_rules_forge TRUE)
  endif()
  if(_TurboFlow_component STREQUAL "TurboDbAdapter")
    set(_TurboFlow_needs_turbodb TRUE)
  endif()
endforeach()

macro(_TurboFlow_require_dependency_root package_name root_name imported_target)
  if(NOT DEFINED ENV{${root_name}} OR "$ENV{${root_name}}" STREQUAL "")
    set(TurboFlow_FOUND FALSE)
    set(TurboFlow_NOT_FOUND_MESSAGE
        "${root_name} is required for TurboFlow dependency ${package_name}")
    return()
  endif()
  if(NOT IS_DIRECTORY "$ENV{${root_name}}")
    set(TurboFlow_FOUND FALSE)
    set(TurboFlow_NOT_FOUND_MESSAGE
        "${root_name} is not a directory: $ENV{${root_name}}")
    return()
  endif()

  file(REAL_PATH "$ENV{${root_name}}" _TurboFlow_dependency_root)
  if(TARGET "${imported_target}" AND
     (NOT DEFINED ${package_name}_DIR OR "${${package_name}_DIR}" STREQUAL ""))
    set(TurboFlow_FOUND FALSE)
    set(TurboFlow_NOT_FOUND_MESSAGE
        "${package_name} is already loaded but its package root cannot be verified")
    return()
  endif()
  if(DEFINED ${package_name}_DIR AND NOT "${${package_name}_DIR}" STREQUAL "")
    file(REAL_PATH "${${package_name}_DIR}" _TurboFlow_dependency_dir)
    cmake_path(IS_PREFIX _TurboFlow_dependency_root
               "${_TurboFlow_dependency_dir}" NORMALIZE
               _TurboFlow_dependency_is_within_root)
    if(NOT _TurboFlow_dependency_is_within_root)
      set(TurboFlow_FOUND FALSE)
      set(TurboFlow_NOT_FOUND_MESSAGE
          "${package_name}_DIR is outside ${root_name}: ${${package_name}_DIR}")
      return()
    endif()
  endif()

  unset(${package_name}_DIR CACHE)
  unset(${package_name}_DIR)
endmacro()

macro(_TurboFlow_verify_dependency_root package_name root_name)
  file(REAL_PATH "$ENV{${root_name}}" _TurboFlow_dependency_root)
  file(REAL_PATH "${${package_name}_DIR}" _TurboFlow_dependency_dir)
  cmake_path(IS_PREFIX _TurboFlow_dependency_root
             "${_TurboFlow_dependency_dir}" NORMALIZE
             _TurboFlow_dependency_is_within_root)
  if(NOT _TurboFlow_dependency_is_within_root)
    set(TurboFlow_FOUND FALSE)
    set(TurboFlow_NOT_FOUND_MESSAGE
        "${package_name} resolved outside ${root_name}: ${${package_name}_DIR}")
    return()
  endif()
endmacro()

_TurboFlow_require_dependency_root(Salts SALTS_ROOT Salts::Core)
find_dependency(Salts CONFIG REQUIRED
                PATHS "$ENV{SALTS_ROOT}" NO_DEFAULT_PATH)
_TurboFlow_verify_dependency_root(Salts SALTS_ROOT)
include("${CMAKE_CURRENT_LIST_DIR}/TurboFlowRequireCNet.cmake")
turbo_flow_require_cnet_stop_drain_contract()
if(_TurboFlow_needs_salts_utils)
  _TurboFlow_require_dependency_root(SaltsUtils SALTS_UTILS_ROOT Salts::DataBind)
  find_dependency(SaltsUtils CONFIG REQUIRED
                  PATHS "$ENV{SALTS_UTILS_ROOT}" NO_DEFAULT_PATH)
  _TurboFlow_verify_dependency_root(SaltsUtils SALTS_UTILS_ROOT)
endif()
if(_TurboFlow_needs_rules_forge)
  _TurboFlow_require_dependency_root(RulesForge RULES_FORGE_ROOT RulesForge::RulesForge)
  find_dependency(RulesForge 0.9 CONFIG REQUIRED
                  PATHS "$ENV{RULES_FORGE_ROOT}" NO_DEFAULT_PATH)
  _TurboFlow_verify_dependency_root(RulesForge RULES_FORGE_ROOT)
endif()
if(_TurboFlow_needs_turbodb)
  _TurboFlow_require_dependency_root(Orm TURBODB_ROOT Orm::C)
  find_dependency(Orm CONFIG REQUIRED
                  PATHS "$ENV{TURBODB_ROOT}" NO_DEFAULT_PATH)
  _TurboFlow_verify_dependency_root(Orm TURBODB_ROOT)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TurboFlowRequireCHTTP.cmake")
turbo_flow_require_chttp_deferred_cancel()

include("${CMAKE_CURRENT_LIST_DIR}/TurboFlowTargets.cmake")

foreach(_TurboFlow_component IN LISTS _TurboFlow_supported_components)
  if(TARGET "TurboFlow::${_TurboFlow_component}")
    set(TurboFlow_${_TurboFlow_component}_FOUND TRUE)
  else()
    set(TurboFlow_${_TurboFlow_component}_FOUND FALSE)
  endif()
endforeach()

check_required_components(TurboFlow)

unset(_TurboFlow_component)
unset(_TurboFlow_dependency_dir)
unset(_TurboFlow_dependency_is_within_root)
unset(_TurboFlow_dependency_root)
unset(_TurboFlow_needs_rules_forge)
unset(_TurboFlow_needs_salts_utils)
unset(_TurboFlow_needs_turbodb)
unset(_TurboFlow_requested_components)
unset(_TurboFlow_rules_forge_components)
unset(_TurboFlow_salts_utils_components)
unset(_TurboFlow_supported_components)
