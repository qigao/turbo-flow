@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(TurboUtils REQUIRED)
if(@TURBO_FLOW_NEEDS_TURBONET@)
  find_dependency(Threads REQUIRED)
  find_dependency(TurboNet REQUIRED)
endif()
if(@TURBO_FLOW_NEEDS_TURBOHTTP@)
  find_dependency(TurboHttp REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TurboFlowTargets.cmake")

set(TurboFlow_Flow_FOUND TRUE)
set(TurboFlow_Flowie_FOUND @TURBO_FLOW_BUILD_FLOWIE@)
set(TurboFlow_FlowieProtocol_FOUND @TURBO_FLOW_BUILD_FLOWIE@)
set(TurboFlow_FlowieClient_FOUND @TURBO_FLOW_BUILD_FLOWIE@)
set(TurboFlow_FlowStorage_FOUND @TURBO_FLOW_BUILD_STORAGE@)
set(TurboFlow_Codec_FOUND @TURBO_FLOW_BUILD_CODEC@)
set(TurboFlow_Socket_FOUND @TURBO_FLOW_BUILD_SOCKET@)
set(TurboFlow_HttpClient_FOUND @TURBO_FLOW_BUILD_HTTP_CLIENT@)
set(TurboFlow_HttpServer_FOUND @TURBO_FLOW_BUILD_HTTP_SERVER@)
if(TurboFlow_HttpClient_FOUND OR TurboFlow_HttpServer_FOUND)
  set(TurboFlow_Http_FOUND TRUE)
else()
  set(TurboFlow_Http_FOUND FALSE)
endif()
set(TurboFlow_RPC_FOUND @TURBO_FLOW_BUILD_RPC@)
set(TurboFlow_S3_FOUND @TURBO_FLOW_BUILD_S3@)
set(TurboFlow_Redis_FOUND @TURBO_FLOW_BUILD_REDIS@)
set(TurboFlow_PostgreSQL_FOUND @TURBO_FLOW_BUILD_PGSQL@)
set(TurboFlow_Email_FOUND @TURBO_FLOW_BUILD_EMAIL@)
set(TurboFlow_FMQ_FOUND @TURBO_FLOW_BUILD_FMQ@)
set(TurboFlow_Observe_FOUND @TURBO_FLOW_BUILD_OBSERVE@)
set(TurboFlow_Schedule_FOUND @TURBO_FLOW_BUILD_SCHEDULE@)
set(TurboFlow_Queue_FOUND @TURBO_FLOW_BUILD_QUEUE@)

check_required_components(TurboFlow)
