diff --git a/src/tools/msvc/Solution.pm b/src/tools/msvc/Solution.pm
index 27d89fc..ae40840 100644
--- a/src/tools/msvc/Solution.pm
+++ b/src/tools/msvc/Solution.pm
@@ -523,6 +523,16 @@ sub GenerateFiles
 		{
 			$define{HAVE_SSL_CTX_SET_CERT_CB} = 1;
 		}
+
+		# BoringSSL implements the OpenSSL 1.1.1 compatibility surface but
+		# exposes X509_get_signature_nid() instead of
+		# X509_get_signature_info(). Keep libpq channel binding enabled via
+		# the capability that is actually present.
+		if ($self->{options}->{boringssl})
+		{
+			$define{HAVE_X509_GET_SIGNATURE_INFO} = undef;
+			$define{HAVE_X509_GET_SIGNATURE_NID} = 1;
+		}
 	}
 
 	$self->GenerateConfigHeader('src/include/pg_config.h', \%define, 1);
